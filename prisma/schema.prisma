generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}

model Hotel {
 id        String   @id @default(uuid())
 name      String
 location  String
 image     String?
 rating    Float?
 createdAt DateTime @default(now())

 rooms   Room[]
 reviews Review[]
}

model Room {
 id      String @id @default(uuid())
 name    String
 price   Int

 hotelId String
 hotel   Hotel @relation(fields: [hotelId], references: [id])

 bookings Booking[]
}

model Booking {
 id       String   @id @default(uuid())
 roomId   String

 checkIn  DateTime
 checkOut DateTime

 name     String?
 email    String?
 phone    String?
 address  String?

 createdAt DateTime @default(now())

 room Room @relation(fields: [roomId], references: [id])
}

model Review {
 id      String @id @default(uuid())
 hotelId String
 rating  Int
 comment String
 createdAt DateTime @default(now())

 hotel Hotel @relation(fields: [hotelId], references: [id])
}
