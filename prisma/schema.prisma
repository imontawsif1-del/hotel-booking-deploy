generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Hotel {
  id        String   @id @default(uuid())
  name      String
  location  String
  createdAt DateTime @default(now())

  rooms     Room[]
}

model Room {
  id       String   @id @default(uuid())
  name     String
  price    Int
  hotelId  String

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  bookings Booking[]
}

model Booking {
  id        String   @id @default(uuid())

  roomId    String
  checkIn   DateTime
  checkOut  DateTime

  // Customer information
  name      String?
  email     String?
  phone     String?

  createdAt DateTime @default(now())

  room      Room @relation(fields: [roomId], references: [id])
}
